{
  "annotations": {
    "list": []
  },
  "editable": true,
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "targets": [
        { "expr": "rate(cache_hits_total[5m])", "legendFormat": "hits" }
      ],
      "title": "Cache hit rate",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "targets": [
        { "expr": "histogram_quantile(0.99, sum(rate(cache_latency_bucket[5m])) by (le))", "legendFormat": "p99 latency" }
      ],
      "title": "P99 latency",
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["cache"],
  "templating": { "list": [] },
  "time": { "from": "now-1h", "to": "now" },
  "title": "Resilient cache dashboard",
  "uid": "resilient-cache-dashboard",
  "version": 1
}
